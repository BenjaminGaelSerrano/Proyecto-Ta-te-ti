import cv2
import numpy as np
# Cargar la imagen
ruta_imagen = "/home/ta-te-ti/Escritorio/Tateti/Proyecto-Ta-te-ti/imagenes/pygamefoto1.jpg"  # Cambiá esto por la ruta de tu imagen
imagen = cv2.imread(ruta_imagen)
# Copia para dibujar encima
output = imagen.copy()
# Obtener dimensiones
alto, ancho = imagen.shape[:2]

# Calcular tercio del alto y ancho
tercio_alto = alto // 3
tercio_ancho = ancho // 3


# Convertir a HSV para detectar rojo
hsv = cv2.cvtColor(imagen, cv2.COLOR_BGR2HSV)

# Rango de rojos (dos rangos)
rojo_bajo1 = np.array([0, 100, 100])
rojo_alto1 = np.array([10, 255, 255])
rojo_bajo2 = np.array([160, 100, 100])
rojo_alto2 = np.array([180, 255, 255])

mascara1 = cv2.inRange(hsv, rojo_bajo1, rojo_alto1)
mascara2 = cv2.inRange(hsv, rojo_bajo2, rojo_alto2)
mascara_rojo = cv2.bitwise_or(mascara1, mascara2)


# Dibujar líneas verticales
for i in range(1, 3):
    x = i * tercio_ancho
    cv2.line(imagen, (x, 0), (x, alto), color=(0, 255, 0), thickness=2)

# Dibujar líneas horizontales
for i in range(1, 3):
    y = i * tercio_alto
    cv2.line(imagen, (0, y), (ancho, y), color=(0, 255, 0), thickness=2)

# Mostrar la imagen con la grilla
cv2.imshow("Grilla Ta-Te-Ti", imagen)
cv2.waitKey(0)
cv2.destroyAllWindows()
